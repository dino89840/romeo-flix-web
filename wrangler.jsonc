{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "romeo-flix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dhak",
      "database_id": "665274b6-5862-4563-8492-023716ab28c6",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "MEDIA_HOSTS": "redirect-passer.pages.dev"
  },

  "observability": {
    "enabled": true
  }
}
